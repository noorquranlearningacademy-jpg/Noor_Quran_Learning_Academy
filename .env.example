# GEMINI_API_KEY: Required for the server-side AI Assistant (/api/chat)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: PostgreSQL connection string (e.g., Neon or Supabase) for persistent bookings & inquiries.
# In local dev without DATABASE_URL, submissions fall back to local data/submissions.json.
DATABASE_URL=""

# Email notifications for new trial bookings & inquiries (configure either Resend OR SMTP)
ACADEMY_NOTIFY_EMAIL="noorquranlearningacademy@gmail.com"
EMAIL_FROM="Noor Quran Academy <onboarding@resend.dev>"
RESEND_API_KEY=""

# Optional SMTP fallback (used if RESEND_API_KEY is empty)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Configurable Academy Contact Details
VITE_ACADEMY_WHATSAPP="923314446892"
